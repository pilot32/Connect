PORT=3000

# Supabase Postgres — from Project Settings > Database
# Connection pooling string (port 6543, transaction mode), append ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (port 5432) — used by Prisma for migrations only
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Self-generated secret for signing our own JWTs, e.g. `openssl rand -base64 32`
JWT_SECRET=

# Seed admin account, created/updated by `npm run seed`. Optional locally —
# defaults to admin@govconnect.in / admin@12345. Always set both in production;
# re-running the seed rotates the password to whatever is set here.
ADMIN_EMAIL=admin@govconnect.in
ADMIN_PASSWORD=

# Cloudinary — from https://console.cloudinary.com (Dashboard > Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
