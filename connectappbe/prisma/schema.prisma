generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum UserStatus {
  pending
  approved
  rejected

  @@map("user_status")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")

  // Optional because admin accounts are seeded, not signed up — they never
  // upload an ID card. Officials signing up still must send one (enforced in
  // the signup controller, not the schema).
  idCardPhotoUrl String? @map("id_card_photo_url")

  role   UserRole   @default(user)
  status UserStatus @default(pending)

  // Review audit trail. reviewedById is a plain column, not a relation: an
  // admin account being deleted must not cascade into or block the applicants
  // they reviewed.
  rejectionReason String?   @map("rejection_reason")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  profile   Profile?

  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionRecipient")
  posts               Post[]

  @@map("users")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  photoUrl       String?  @map("photo_url")
  designation    String
  service        String
  department     String
  stateOrCadre   String   @map("state_or_cadre")
  yearsInService Int      @map("years_in_service")
  bio            String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

enum ConnectionStatus {
  pending
  accepted
  declined

  @@map("connection_status")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([requesterId, recipientId])
  @@map("connections")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("posts")
}
