# Copy to `.env` before running the app or the tests.
#
# `.env` is declared as a Flutter asset in pubspec.yaml, so its absence fails
# the asset bundle build outright — `flutter run` and `flutter test` both stop
# before they start. It is gitignored, so a fresh clone has to create it.
#
# Leave API_BASE_URL blank to use the per-platform default in
# lib/core/config/env.dart: http://10.0.2.2:3000 on the Android emulator
# (its alias for the host machine's localhost) and http://localhost:3000
# everywhere else. Set it to point at a deployed backend, e.g.
# https://connect-api.onrender.com
API_BASE_URL=
